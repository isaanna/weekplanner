  "prep": [
    {
      "step": "Rindfleischtopf starten: 900 g Rindergulasch portionsweise in etwas Rapsöl anbraten, mit 1,2 l Rinderbrühe ablöschen, 2 Lorbeerblätter zugeben und zugedeckt 60 Minuten köcheln lassen.",
      "time": "0:00–0:15",
      "when": "Sonntag"
    },
    {
      "step": "Ofen auf 180 °C vorheizen. 250 g Kartoffeln für die Muffins schälen, klein würfeln und ca. 12 Minuten in Salzwasser garen, dann abgießen.",
      "time": "0:05–0:20",
      "when": "Sonntag"
    },
    {
      "step": "Quarkauflauf: 500 g Magerquark, 3 Eier, 40 g Grieß, Zucker, Vanille und Zitronenschale verrühren, 250 g TK-Beeren unterheben. In eine gefettete Form geben und bei 180 °C ca. 40 Minuten backen (bis ca. 1:10).",
      "time": "0:15–0:30",
      "when": "Sonntag"
    },
    {
      "step": "Muffins: Paprika und Kochschinken würfeln und mit den Kartoffelwürfeln in einem 12er-Muffinblech verteilen. 8 Eier mit Hüttenkäse, Gouda, Salz, Pfeffer und Oregano verquirlen und eingießen. Ab 0:45 bei 180 °C ca. 25 Minuten mitbacken.",
      "time": "0:30–0:45",
      "when": "Sonntag"
    },
    {
      "step": "Für den Rindfleischtopf 1 kg Kartoffeln und 600 g Möhren schälen und würfeln. Für das Blech 800 g Kartoffeln würfeln und 2 Paprika sowie 1 Zucchini in Stücke schneiden.",
      "time": "0:45–1:05",
      "when": "Sonntag"
    },
    {
      "step": "Kartoffeln und Möhren in den Rindfleischtopf geben und weitere 25–30 Minuten köcheln lassen.",
      "time": "1:05–1:10",
      "when": "Sonntag"
    },
    {
      "step": "Auflauf und Muffins aus dem Ofen nehmen und abkühlen lassen. Ofen auf 200 °C hochschalten.",
      "time": "1:10–1:15",
      "when": "Sonntag"
    },
    {
      "step": "Blech-Kartoffeln mit 1 EL Olivenöl, Salz und Rosmarin mischen und 15 Minuten vorbacken. Inzwischen 600 g Hähnchenbrust würfeln und mit Paprika, Zucchini, restlichem Öl, gepresstem Knoblauch, Paprikapulver und Salz mischen.",
      "time": "1:15–1:30",
      "when": "Sonntag"
    },
    {
      "step": "Hähnchen und Gemüse zu den Kartoffeln geben und 20 Minuten fertig backen. Inzwischen den Joghurt-Dip (200 g Joghurt, Saft von ½ Zitrone, Salz) anrühren und auf 4 Döschen verteilen.",
      "time": "1:30–1:50",
      "when": "Sonntag"
    },
    {
      "step": "Rindfleischtopf abschmecken, Lorbeer entfernen, Petersilie unterrühren und den Topf zum Abkühlen vom Herd nehmen.",
      "time": "1:40–1:45",
      "when": "Sonntag"
    },
    {
      "step": "Abfüllen: 6 Dosen Rindfleischtopf, 4 Dosen Hähnchen-Blech mit separatem Dip, Quarkauflauf in 4 Stücke, Muffins zu je 2 Stück in 6 Portionen. Die 2 Muffinportionen für Freitag einfrieren, alles andere in den Kühlschrank stellen. Fleisch für Mittwoch und Donnerstag einfrieren, falls es nicht frisch gekauft wird.",
      "time": "1:50–2:10",
      "when": "Sonntag"
    }
  ],
